---
import { SITE, CLINIC } from '~/config';
import type { FaqItem } from '~/content/site';

// LocalBusiness/Dentist structured data for the practice and the dentist.
// Intentionally omits aggregateRating/review (Google restricts that markup to
// sites reviewing OTHER businesses) and openingHours (the clinic is by
// appointment with variable Málaga periods, so fixed hours would be inaccurate).
// The prices page passes `offers` ("desde" figures, hence minPrice) and the FAQ
// page passes `faq`; both extend the same single @graph.
interface Props {
  offers?: { name: string; price: number }[];
  faq?: FaqItem[];
}
const { offers, faq } = Astro.props;

const clinicId = `${SITE.domain}/#clinic`;
const personId = `${SITE.domain}/#dentist`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Dentist',
      '@id': clinicId,
      name: 'Clínica Dental Dra. Eugenia Vila',
      url: SITE.domain,
      image: `${SITE.domain}${SITE.ogImage}`,
      telephone: CLINIC.phoneE164,
      email: CLINIC.email,
      priceRange: '$$',
      medicalSpecialty: 'Dentistry',
      address: {
        '@type': 'PostalAddress',
        streetAddress: CLINIC.addressLine,
        addressLocality: 'Málaga',
        postalCode: '29017',
        addressCountry: 'ES',
      },
      geo: { '@type': 'GeoCoordinates', latitude: CLINIC.geo.latitude, longitude: CLINIC.geo.longitude },
      areaServed: { '@type': 'City', name: 'Málaga' },
      sameAs: [CLINIC.gbpUrl, CLINIC.mapsPlaceUrl],
      founder: { '@id': personId },
      ...(offers?.length && {
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: 'Tratamientos',
          itemListElement: offers.map((o) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: o.name },
            priceCurrency: 'EUR',
            priceSpecification: { '@type': 'PriceSpecification', minPrice: o.price, priceCurrency: 'EUR' },
          })),
        },
      }),
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Dra. Eugenia Vila',
      jobTitle: 'Dentista',
      worksFor: { '@id': clinicId },
      url: SITE.domain,
      sameAs: [CLINIC.linkedin, CLINIC.doctoralia],
      identifier: {
        '@type': 'PropertyValue',
        propertyID: 'GDC',
        value: CLINIC.gdc,
      },
    },
    ...(faq?.length
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faq.map((item) => ({
              '@type': 'Question',
              name: item.question,
              acceptedAnswer: { '@type': 'Answer', text: item.answer },
            })),
          },
        ]
      : []),
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
