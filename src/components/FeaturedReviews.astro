---
import { Icon } from 'astro-icon/components';
import ReviewCard from '~/components/ReviewCard.astro';
import { content } from '~/content/site';
import { getFeaturedReviews } from '~/utils/reviews';
import { ROUTES, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const f = content[lang].featuredReviews;
const reviews = getFeaturedReviews(6);
---

<section class="section bg-brand-light/40">
  <div class="container-page">
    <p class="eyebrow">{f.eyebrow}</p>
    <h2 class="mt-2 font-heading text-3xl text-brand-deep sm:text-4xl">{f.title}</h2>
    <p class="mt-3 text-ink/75">{f.subtitle}</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {reviews.map((r) => <ReviewCard review={r} lang={lang} />)}
    </div>

    <div class="mt-8 text-center">
      <a href={ROUTES.reviews[lang]} class="btn-outline">
        {f.viewAll}
        <Icon name="tabler:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
