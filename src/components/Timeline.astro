---
import type { TimelineItem } from '~/content/site';

interface Props {
  items: TimelineItem[];
}
const { items } = Astro.props;
---

<ol class="relative ml-1.5 border-l border-brand-teal/20 pl-6">
  {
    items.map((it) => (
      <li class="mb-6 last:mb-0">
        <span class="absolute -left-[7px] mt-1.5 h-3.5 w-3.5 rounded-full border-2 border-cream bg-brand-green" />
        <p class="font-heading text-base text-brand-deep">{it.title}</p>
        <p class="text-sm text-ink/70">{it.org}</p>
        <p class="mt-0.5 text-xs text-sage">{it.date}</p>
      </li>
    ))
  }
</ol>
