---
import { Icon } from 'astro-icon/components';
import { content } from '~/content/site';
import { PRICES, TREATMENTS } from '~/config';
import { formatPrice } from '~/utils/prices';
import { ROUTES, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {
    TREATMENTS.map((tr) => {
      const c = t.treatments[tr.id];
      return (
        <a
          href={ROUTES[tr.route][lang]}
          class="card group flex flex-col transition hover:border-brand-blue/30 hover:shadow-md"
        >
          <span class="flex h-14 w-14 items-center justify-center rounded-full border border-brand-blue/20 bg-brand-light text-brand-blue">
            <Icon name={tr.icon} class="h-7 w-7" />
          </span>
          <h3 class="mt-4 font-heading text-xl text-brand-deep">{c.card.title}</h3>
          <p class="mt-2 grow text-sm leading-relaxed text-ink/75">{c.card.description}</p>
          <p class="mt-3 text-sm text-ink/60">
            {t.treatmentsPage.from}
            <span class="ml-1 font-heading text-lg font-semibold text-brand-deep">
              {formatPrice(PRICES[tr.featuredPrice], lang)}
            </span>
          </p>
          <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-blue">
            {t.treatmentsPage.viewDetails}
            <Icon name="tabler:arrow-right" class="h-4 w-4 transition group-hover:translate-x-0.5" />
          </span>
        </a>
      );
    })
  }
</div>
