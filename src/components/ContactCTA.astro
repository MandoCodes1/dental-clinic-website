---
import { Icon } from 'astro-icon/components';
import { content } from '~/content/site';
import { waLink } from '~/config';
import type { Lang } from '~/i18n';

type CtaPage = 'home' | 'about' | 'services' | 'prices' | 'reviews' | 'gallery' | 'products' | 'faq';

interface Props {
  lang: Lang;
  page?: CtaPage;
}
const { lang, page = 'home' } = Astro.props;
const cta = content[lang].contactCta;
const c = cta[page];
---

<section class="section text-center">
  <div class="container-page">
    <h2 class="mx-auto max-w-2xl font-heading text-3xl text-brand-deep sm:text-4xl">{c.title}</h2>
    <p class="mx-auto mt-3 max-w-xl text-ink/75">{c.body}</p>
    <a
      href={waLink(c.message)}
      target="_blank"
      rel="noopener"
      class="btn-whatsapp mt-7"
      data-umami-event="whatsapp"
      data-umami-event-location="cta"
    >
      <Icon name="tabler:brand-whatsapp" class="h-6 w-6" />
      {cta.button}
    </a>
  </div>
</section>
