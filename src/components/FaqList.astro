---
import { Icon } from 'astro-icon/components';
import type { FaqItem } from '~/content/site';
import { ROUTES, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  items: FaqItem[];
}
const { lang, items } = Astro.props;
---

<div class="mx-auto max-w-3xl space-y-4">
  {
    items.map((item) => (
      <details class="card group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-ink [&::-webkit-details-marker]:hidden">
          {item.question}
          <Icon
            name="tabler:chevron-down"
            class="h-5 w-5 shrink-0 text-brand-blue transition-transform group-open:rotate-180"
          />
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-ink/70">{item.answer}</p>
        {item.link && (
          <a
            href={ROUTES[item.link.route][lang]}
            class="link-quiet mt-2 inline-flex items-center gap-1 text-sm font-medium"
          >
            {item.link.label}
            <Icon name="tabler:arrow-right" class="h-4 w-4" />
          </a>
        )}
      </details>
    ))
  }
</div>
