---
import { Icon } from 'astro-icon/components';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { content } from '~/content/site';
import { PRICES } from '~/config';
import { formatPrice } from '~/utils/prices';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const p = t.pricesPage;
---

<BaseLayout lang={lang} page="prices">
  <PageHeader title={p.title} lead={p.lead} />
  <section class="section bg-cream">
    <div class="container-page">
      <div class="card mx-auto flex max-w-3xl items-start gap-4">
        <Icon name="tabler:info-circle" class="h-6 w-6 shrink-0 text-brand-blue" />
        <p class="text-sm leading-relaxed text-ink/70">{p.disclaimer}</p>
      </div>

      <div class="mx-auto mt-8 max-w-3xl space-y-6">
        {
          p.groups.map((group) => (
            <div class="card">
              <h2 class="font-heading text-2xl text-brand-deep">{group.title}</h2>
              <dl class="mt-2 divide-y divide-brand-blue/10">
                {group.items.map((item) => (
                  <div class="flex items-baseline justify-between gap-6 py-3">
                    <dt>
                      <span class="font-medium text-ink">{item.label}</span>
                      {item.note && <span class="mt-0.5 block text-sm text-ink/60">{item.note}</span>}
                    </dt>
                    <dd class="whitespace-nowrap text-right">
                      <span class="text-sm text-ink/60">{p.from}</span>
                      <span class="ml-1 font-heading text-xl font-semibold text-brand-deep">
                        {formatPrice(PRICES[item.id], lang)}
                      </span>
                    </dd>
                  </div>
                ))}
              </dl>
              {group.items.some((item) => item.id === 'implantCrown') && (
                <p class="mt-2 border-t border-brand-blue/10 pt-4 text-sm leading-relaxed text-ink/60">{p.cbctNote}</p>
              )}
            </div>
          ))
        }
      </div>

      {/* The WhatsApp button lives in the ContactCTA below, so this is text only. */}
      <p class="mx-auto mt-8 max-w-3xl text-center text-ink/75">{p.askQuote}</p>
    </div>
  </section>
  <ContactCTA lang={lang} page="prices" />
</BaseLayout>
