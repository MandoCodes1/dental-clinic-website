---
import { Icon } from 'astro-icon/components';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import ProcessSteps from '~/components/ProcessSteps.astro';
import FaqList from '~/components/FaqList.astro';
import ReviewCard from '~/components/ReviewCard.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import TreatmentIllustration from '~/components/TreatmentIllustration.astro';
import { content, getFaqItems, TREATMENT_FAQS } from '~/content/site';
import { GUIDES, PRICES, TREATMENTS, waLink, type TreatmentId } from '~/config';
import { formatPrice } from '~/utils/prices';
import { getTreatmentReviews } from '~/utils/reviews';
import { ROUTES, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  treatment: TreatmentId;
}
const { lang, treatment } = Astro.props;
const t = content[lang];
const p = t.treatmentsPage;
const def = TREATMENTS.find((tr) => tr.id === treatment)!;
const c = t.treatments[treatment];

const faqItems = getFaqItems(lang, TREATMENT_FAQS[treatment]);
const reviews = getTreatmentReviews(treatment, 3);

// The fourth "why me" card is treatment-specific; the icon comes from the
// treatment definition so the swap slot stays visually tied to the page.
const whyMeCards = [
  { icon: 'tabler:user-heart', ...p.whyMe.items[0] },
  { icon: 'tabler:file-certificate', ...p.whyMe.items[1] },
  { icon: 'tabler:award', ...p.whyMe.items[2] },
  { icon: def.icon, ...c.whyMeExtra },
];

// "Desde" figures for the OfferCatalog structured data; each treatment page
// carries its own price table, so each emits its own offers.
const offers = c.priceGroup.items.filter((i) => i.id).map((i) => ({ name: i.label, price: PRICES[i.id!] }));

// Not every treatment has a guide worth pointing at, so this is optional.
const guideId = 'guide' in def ? def.guide : undefined;
const guide = guideId ? t.guides[guideId] : undefined;
const guideHref = guideId ? ROUTES[GUIDES.find((g) => g.id === guideId)!.route][lang] : undefined;
---

<BaseLayout lang={lang} page={def.route} title={c.meta.title} description={c.meta.description} offers={offers}>
  <PageHeader title={c.title} lead={c.lead}>
    <a
      href={waLink(c.cta.message)}
      target="_blank"
      rel="noopener"
      class="btn-whatsapp mt-6"
      data-umami-event="whatsapp"
      data-umami-event-location={`hero-${treatment}`}
    >
      <Icon name="tabler:brand-whatsapp" class="h-6 w-6" />
      {t.hero.ctaBook}
    </a>
  </PageHeader>

  {/* What it is, in plain words, next to the illustration */}
  <section class="section bg-white">
    <div class="container-page">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="mx-auto w-full max-w-md rounded-2xl bg-brand-light p-6 ring-1 ring-brand-blue/10">
          <TreatmentIllustration treatment={treatment} class="mx-auto h-auto w-full max-w-sm" />
        </div>
        <div>
          <h2 class="font-heading text-2xl text-brand-deep sm:text-3xl">{c.whatIs.title}</h2>
          {c.whatIs.body.map((para) => <p class="mt-4 leading-relaxed text-ink/75">{para}</p>)}
        </div>
      </div>
    </div>
  </section>

  {/* Patient situations, problem-first */}
  <section class="section bg-cream">
    <div class="container-page">
      <h2 class="text-center font-heading text-2xl text-brand-deep sm:text-3xl">{c.situations.title}</h2>
      <div
        class:list={[
          'mx-auto mt-8 grid max-w-5xl gap-5 sm:grid-cols-2',
          c.situations.items.length !== 4 && 'lg:grid-cols-3',
        ]}
      >
        {
          c.situations.items.map((item) => (
            <div class="card">
              <h3 class="font-heading text-lg text-brand-deep">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* The visit-by-visit walkthrough, kept short */}
  <section class="section bg-white">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-heading text-2xl text-brand-deep sm:text-3xl">{c.process.title}</h2>
        <p class="mt-3 text-ink/75">{c.process.intro}</p>
      </div>
      <div class="mx-auto mt-10 max-w-md lg:max-w-none">
        <ProcessSteps steps={c.process.steps} />
      </div>
    </div>
  </section>

  {/* Why me: three shared cards plus the treatment-specific one */}
  <section class="section bg-brand-light/40">
    <div class="container-page">
      <h2 class="text-center font-heading text-2xl text-brand-deep sm:text-3xl">{p.whyMe.title}</h2>
      <div class="mx-auto mt-8 grid max-w-5xl gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          whyMeCards.map((card) => (
            <div class="card">
              <Icon name={card.icon} class="h-7 w-7 text-brand-blue" />
              <h3 class="mt-3 font-medium text-ink">{card.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink/65">{card.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Prices */}
  <section class="section bg-white">
    <div class="container-page">
      <div class="card mx-auto max-w-3xl">
        <h2 class="font-heading text-2xl text-brand-deep">{c.priceGroup.title}</h2>
        <dl class="mt-2 divide-y divide-brand-blue/10">
          {
            c.priceGroup.items.map((item) => (
              <div class="flex items-baseline justify-between gap-4 py-3 sm:gap-6">
                <dt>
                  <span class="font-medium text-ink">{item.label}</span>
                  {item.note && <span class="mt-0.5 block text-sm text-ink/60">{item.note}</span>}
                </dt>
                <dd class="text-right">
                  {item.id ? (
                    <span class="whitespace-nowrap">
                      <span class="text-sm text-ink/60">{p.from}</span>
                      <span class="ml-1 font-heading text-xl font-semibold text-brand-deep">
                        {formatPrice(PRICES[item.id], lang)}
                      </span>
                    </span>
                  ) : (
                    <span class="font-heading text-lg font-semibold text-brand-deep">{p.customQuote}</span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        {
          c.priceGroup.note && (
            <p class="mt-2 border-t border-brand-blue/10 pt-4 text-sm leading-relaxed text-ink/60">
              {c.priceGroup.note}
            </p>
          )
        }
        <p class="mt-4 text-sm leading-relaxed text-ink/60">{p.disclaimer}</p>
        {
          guide && guideHref && (
            <p class="mt-4 text-sm leading-relaxed text-ink/70">
              {p.guidePrompt}{' '}
              <a href={guideHref} class="link-quiet font-medium">
                {guide.card.title}
                <Icon name="tabler:arrow-right" class="ml-0.5 inline h-4 w-4 align-text-bottom" />
              </a>
            </p>
          )
        }
      </div>
    </div>
  </section>

  {/* Social proof for this treatment */}
  <section class="section bg-cream">
    <div class="container-page">
      <h2 class="text-center font-heading text-2xl text-brand-deep sm:text-3xl">{p.reviewsTitle}</h2>
      <div class="mx-auto mt-8 grid max-w-5xl gap-5 md:grid-cols-3">
        {reviews.map((review) => <ReviewCard review={review} lang={lang} />)}
      </div>
      <div class="mt-8 text-center">
        <a href={ROUTES.reviews[lang]} class="btn-outline">
          {t.featuredReviews.viewAll}
          <Icon name="tabler:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="section bg-white">
    <div class="container-page">
      <h2 class="mx-auto max-w-3xl font-heading text-2xl text-brand-deep">{t.homeFaq.title}</h2>
      <div class="mt-4">
        <FaqList items={faqItems} />
      </div>
      <div class="mt-8 text-center">
        <a href={ROUTES.faq[lang]} class="btn-outline">
          {t.homeFaq.viewAll}
          <Icon name="tabler:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <ContactCTA lang={lang} override={c.cta} location={`cta-${treatment}`} />
</BaseLayout>
