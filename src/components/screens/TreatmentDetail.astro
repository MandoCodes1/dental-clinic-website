---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import FaqList from '~/components/FaqList.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { content, getFaqItems, TREATMENT_FAQS } from '~/content/site';
import { PRICES, TREATMENTS, type TreatmentId } from '~/config';
import { formatPrice } from '~/utils/prices';
import { ROUTES, type Lang } from '~/i18n';

import implantImg from '~/assets/images/implant.webp';
import oralSurgeryImg from '~/assets/images/oral_surgery.webp';
import alignerImg from '~/assets/images/aligner.webp';
import cosmeticImg from '~/assets/images/cosmetic_dentistry.webp';
import treatmentRoomImg from '~/assets/images/wide_treatment_room.jpg';
import closeUpImg from '~/assets/images/close_up_square.jpg';

interface Props {
  lang: Lang;
  treatment: TreatmentId;
}
const { lang, treatment } = Astro.props;
const t = content[lang];
const p = t.treatmentsPage;
const def = TREATMENTS.find((tr) => tr.id === treatment)!;
const c = t.treatments[treatment];

// General and crowns reuse clinic photos until dedicated ones exist.
const images: Record<TreatmentId, ImageMetadata> = {
  implants: implantImg,
  oralSurgery: oralSurgeryImg,
  orthodontics: alignerImg,
  aesthetics: cosmeticImg,
  general: treatmentRoomImg,
  crowns: closeUpImg,
};

const faqItems = getFaqItems(lang, TREATMENT_FAQS[treatment]);

// "Desde" figures for the OfferCatalog structured data; each treatment page
// carries its own price table, so each emits its own offers.
const offers = c.priceGroup.items.filter((i) => i.id).map((i) => ({ name: i.label, price: PRICES[i.id!] }));
---

<BaseLayout lang={lang} page={def.route} title={c.meta.title} description={c.meta.description} offers={offers}>
  <PageHeader title={c.title} lead={c.lead} />

  <section class="section bg-white">
    <div class="container-page">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="mx-auto max-w-md rounded-2xl bg-brand-light p-4 ring-1 ring-brand-blue/10 lg:max-w-none">
          <Image
            src={images[treatment]}
            alt={c.title}
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 90vw, 460px"
            class="w-full rounded-xl object-contain"
          />
        </div>
        <ul class="space-y-2.5">
          {
            c.points.map((point) => (
              <li class="flex gap-2.5 text-ink/80">
                <Icon name="tabler:check" class="mt-1 h-4 w-4 shrink-0 text-brand-sky" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {
        c.process && (
          <div class="mx-auto mt-12 max-w-3xl">
            <h2 class="font-heading text-2xl text-brand-deep">{c.process.title}</h2>
            <p class="mt-3 text-ink/75">{c.process.intro}</p>
            <ol class="mt-6 space-y-6">
              {c.process.steps.map((step, i) => (
                <li class="flex gap-4">
                  <span class="flex h-8 w-8 shrink-0 select-none items-center justify-center rounded-full bg-brand-light font-heading text-lg font-semibold text-brand-deep ring-1 ring-brand-blue/10">
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="pt-1 font-medium text-ink">{step.title}</h3>
                    <p class="mt-1 leading-relaxed text-ink/70">{step.description}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )
      }

      <div class="card mx-auto mt-12 max-w-3xl">
        <h2 class="font-heading text-2xl text-brand-deep">{c.priceGroup.title}</h2>
        <dl class="mt-2 divide-y divide-brand-blue/10">
          {
            c.priceGroup.items.map((item) => (
              <div class="flex items-baseline justify-between gap-4 py-3 sm:gap-6">
                <dt>
                  <span class="font-medium text-ink">{item.label}</span>
                  {item.note && <span class="mt-0.5 block text-sm text-ink/60">{item.note}</span>}
                </dt>
                <dd class="text-right">
                  {item.id ? (
                    <span class="whitespace-nowrap">
                      <span class="text-sm text-ink/60">{p.from}</span>
                      <span class="ml-1 font-heading text-xl font-semibold text-brand-deep">
                        {formatPrice(PRICES[item.id], lang)}
                      </span>
                    </span>
                  ) : (
                    <span class="font-heading text-lg font-semibold text-brand-deep">{p.customQuote}</span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        {
          c.priceGroup.note && (
            <p class="mt-2 border-t border-brand-blue/10 pt-4 text-sm leading-relaxed text-ink/60">
              {c.priceGroup.note}
            </p>
          )
        }
        <p class="mt-4 text-sm leading-relaxed text-ink/60">{p.disclaimer}</p>
      </div>

      <h2 class="mx-auto mt-12 max-w-3xl font-heading text-2xl text-brand-deep">{t.homeFaq.title}</h2>
      <div class="mt-4">
        <FaqList items={faqItems} />
      </div>
      <div class="mt-8 text-center">
        <a href={ROUTES.faq[lang]} class="btn-outline">
          {t.homeFaq.viewAll}
          <Icon name="tabler:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <ContactCTA lang={lang} override={c.cta} location={`cta-${treatment}`} />
</BaseLayout>
