---
import { Icon } from 'astro-icon/components';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { content } from '~/content/site';
import { GUIDES, type GuideId } from '~/config';
import { ROUTES, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  guide: GuideId;
}
const { lang, guide } = Astro.props;
const t = content[lang];
const c = t.guides[guide];
const def = GUIDES.find((g) => g.id === guide)!;
// The other guides, so every guide page links on to the rest of the set.
const others = GUIDES.filter((g) => g.id !== guide);
---

<BaseLayout lang={lang} page={def.route} title={c.meta.title} description={c.meta.description}>
  <PageHeader title={c.title} lead={c.lead} />

  <section class="section bg-white">
    <div class="container-page">
      <article class="mx-auto max-w-3xl">
        {
          c.sections.map((section) => (
            <div class="mt-10 first:mt-0">
              <h2 class="font-heading text-2xl text-brand-deep">{section.title}</h2>
              {section.body.map((paragraph) => (
                <p class="mt-3 leading-relaxed text-ink/75">{paragraph}</p>
              ))}
            </div>
          ))
        }
      </article>

      <div class="mx-auto mt-12 max-w-3xl border-t border-brand-blue/10 pt-8">
        <ul class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {
            others.map((other) => (
              <li>
                <a
                  href={ROUTES[other.route][lang]}
                  class="inline-flex items-center gap-2 text-sm font-medium text-brand-blue hover:underline"
                >
                  <Icon name={other.icon} class="h-4 w-4" />
                  {t.guides[other.id].card.title}
                </a>
              </li>
            ))
          }
        </ul>
        <a href={ROUTES.guides[lang]} class="btn-outline mt-6">
          {t.guidesPage.backToGuides}
          <Icon name="tabler:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <ContactCTA lang={lang} override={c.cta} location={`cta-guide-${guide}`} />
</BaseLayout>
