---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import FaqList from '~/components/FaqList.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { content } from '~/content/site';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const f = content[lang].faqPage;
---

<BaseLayout lang={lang} page="faq" faq={f.items}>
  <PageHeader title={f.title} lead={f.lead} />
  {/* No bottom padding: the body is cream too, so it would only stack with the CTA's own. */}
  <section class="section bg-cream pb-0">
    <div class="container-page">
      <FaqList items={f.items} />
    </div>
  </section>
  <ContactCTA lang={lang} page="faq" />
</BaseLayout>
