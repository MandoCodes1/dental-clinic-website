---
import { Icon } from 'astro-icon/components';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import TreatmentCards from '~/components/TreatmentCards.astro';
import FaqList from '~/components/FaqList.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { content, getFaqItems } from '~/content/site';
import { ROUTES, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const p = t.treatmentsPage;

// The two money questions the per-treatment tables do not already answer.
const faqItems = getFaqItems(lang, ['guarantee', 'payment']);
---

<BaseLayout lang={lang} page="treatments">
  <PageHeader title={p.title} lead={p.lead} />

  <section class="section bg-white">
    <div class="container-page">
      <TreatmentCards lang={lang} />
    </div>
  </section>

  {/* No bottom padding: the body is cream too, so it would only stack with the CTA's own. */}
  <section id="calidad" class="section scroll-mt-24 bg-cream pb-0">
    <div class="container-page">
      <div class="card mx-auto max-w-3xl">
        <h2 class="font-heading text-2xl text-brand-deep">{p.quality.title}</h2>
        <p class="mt-3 leading-relaxed text-ink/75">{p.quality.lead}</p>
        <ul class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2">
          {
            p.quality.points.map((point) => (
              <li class="flex items-start gap-3">
                <Icon name="tabler:shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-brand-blue" />
                <div>
                  <p class="font-medium text-ink">{point.title}</p>
                  <p class="mt-0.5 text-sm leading-relaxed text-ink/60">{point.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <h2 class="mx-auto mt-10 max-w-3xl font-heading text-2xl text-brand-deep">{p.faqTitle}</h2>
      <div class="mt-4">
        <FaqList lang={lang} items={faqItems} />
      </div>

      {/* The WhatsApp button lives in the ContactCTA below, so this is text only. */}
      <p class="mx-auto mt-10 max-w-3xl text-center text-ink/75">{p.askQuote}</p>
      <p class="mx-auto mt-2 max-w-3xl text-center text-sm text-ink/60">
        {p.faqPrompt}
        <a href={ROUTES.faq[lang]} class="link-quiet ml-1">{p.faqLink}</a>
      </p>
    </div>
  </section>

  <ContactCTA lang={lang} page="treatments" />
</BaseLayout>
