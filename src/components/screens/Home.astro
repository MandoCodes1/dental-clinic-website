---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import CredentialsBand from '~/components/CredentialsBand.astro';
import TreatmentCards from '~/components/TreatmentCards.astro';
import Values from '~/components/Values.astro';
import FeaturedReviews from '~/components/FeaturedReviews.astro';
import HomeFaq from '~/components/HomeFaq.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { content } from '~/content/site';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = content[lang].treatmentsPage.home;
---

<BaseLayout lang={lang} page="home">
  <Hero lang={lang} />
  <CredentialsBand lang={lang} />
  <section class="section bg-white">
    <div class="container-page">
      <p class="eyebrow">{h.eyebrow}</p>
      <h2 class="mt-2 max-w-2xl font-heading text-3xl text-brand-deep sm:text-4xl">{h.title}</h2>
      <p class="mt-3 max-w-2xl text-ink/75">{h.subtitle}</p>
      <div class="mt-10">
        <TreatmentCards lang={lang} />
      </div>
    </div>
  </section>
  <Values lang={lang} />
  <FeaturedReviews lang={lang} />
  <HomeFaq lang={lang} />
  <ContactCTA lang={lang} page="home" />
</BaseLayout>
