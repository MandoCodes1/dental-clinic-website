---
import { Icon } from 'astro-icon/components';
import { switchLangPath, type Lang } from '~/i18n';
import { content } from '~/content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const href = switchLangPath(Astro.url.pathname);
// The banner speaks the language it is suggesting, so read the other locale's copy.
const t = content[other];
---

<div
  id="lang-suggest"
  data-page-lang={lang}
  data-other-lang={other}
  lang={other}
  aria-live="polite"
  class="hidden border-b border-brand-blue/15 bg-brand-light text-brand-deep"
>
  <div class="container-page flex items-center justify-center gap-3 py-2 text-sm">
    <span>{t.langSuggest.message}</span>
    <a
      href={href}
      hreflang={other}
      data-cta
      class="shrink-0 font-semibold underline underline-offset-2 hover:no-underline"
    >
      {t.langSuggest.cta}
    </a>
    <button
      type="button"
      data-dismiss
      aria-label={t.langSuggest.dismiss}
      class="ml-1 shrink-0 text-brand-deep/60 transition hover:text-brand-deep"
    >
      <Icon name="tabler:x" class="h-4 w-4" />
    </button>
  </div>
</div>

<script>
  function initLangSuggest() {
    const el = document.getElementById('lang-suggest');
    if (!el || el.dataset.bound) return;
    el.dataset.bound = 'true';

    let dismissed = false;
    try {
      dismissed = localStorage.getItem('langSuggestDismissed') === '1';
    } catch {
      /* localStorage may be blocked (private mode); skip persistence */
    }
    if (dismissed) return;

    const pageLang = el.dataset.pageLang || 'es';
    const otherLang = el.dataset.otherLang || 'en';
    const prefs = (
      navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || '']
    ).map((l) => l.toLowerCase());
    const prefers = (code: string) => prefs.some((l) => l === code || l.startsWith(code + '-'));

    // Suggest the other language only when the visitor's browser prefers it
    // and does not already prefer the language of the current page.
    if (prefers(otherLang) && !prefers(pageLang)) {
      el.classList.remove('hidden');
    }

    const remember = () => {
      try {
        localStorage.setItem('langSuggestDismissed', '1');
      } catch {
        /* ignore */
      }
    };
    el.querySelector('[data-dismiss]')?.addEventListener('click', () => {
      el.classList.add('hidden');
      remember();
    });
    el.querySelector('[data-cta]')?.addEventListener('click', remember);
  }

  document.addEventListener('astro:page-load', initLangSuggest);
</script>
