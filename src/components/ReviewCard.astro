---
import { Icon } from 'astro-icon/components';
import { getAvatarDisplay, type Review } from '~/utils/reviews';
import { content } from '~/content/site';
import type { Lang } from '~/i18n';

interface Props {
  review: Review;
  lang: Lang;
}
const { review, lang } = Astro.props;
const t = content[lang];
const text = lang === 'es' ? review.text_es : review.text_en;
const london = lang === 'es' ? 'Londres' : 'London';
const labels: Record<string, string> = {
  malaga: 'Málaga',
  balham: `${london} · Balham`,
  finchley: `${london} · Finchley`,
};
const location = labels[review.clinic] ?? '';
const avatar = getAvatarDisplay(review.avatar);
const sourceIcon = review.source === 'Trustpilot' ? 'tabler:star' : 'tabler:brand-google';
// Each review link is unique, so a hash of it gives the quote a stable id for
// the expand button to point at. The Google links share long common parts, so
// a slice of the URL itself is not enough.
let hash = 5381;
for (const ch of review.link) hash = ((hash * 33) ^ ch.charCodeAt(0)) >>> 0;
const textId = `review-${hash.toString(36)}`;
---

<figure class="card flex h-full flex-col">
  <div class="flex items-center gap-3">
    {
      avatar.type === 'image' ? (
        <img
          src={avatar.value}
          alt=""
          width="40"
          height="40"
          loading="lazy"
          referrerpolicy="no-referrer"
          class="h-10 w-10 rounded-full object-cover"
        />
      ) : (
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-light text-sm font-semibold text-brand-deep">
          {avatar.value}
        </span>
      )
    }
    <div class="min-w-0">
      <figcaption class="truncate font-semibold text-ink">{review.name}</figcaption>
      {location && <p class="text-xs text-sage">{location}</p>}
    </div>
  </div>

  <div class="mt-3 flex gap-0.5 text-brand-sky" role="img" aria-label="5/5">
    {Array.from({ length: 5 }).map(() => <Icon name="tabler:star-filled" class="h-4 w-4" />)}
  </div>

  <div class="mt-3 grow">
    <blockquote id={textId} data-review-text class="line-clamp-6 text-sm leading-relaxed text-ink/80">
      {text}
    </blockquote>
    {
      /* Hidden until the script finds the quote actually clipped, so short
        reviews do not get a button that does nothing. */
    }
    <button
      type="button"
      data-review-toggle
      aria-expanded="false"
      aria-controls={textId}
      data-label-more={t.common.readMore}
      data-label-less={t.common.readLess}
      class="mt-1 hidden text-sm font-medium text-brand-blue underline underline-offset-4 hover:decoration-2"
    >
      {t.common.readMore}
    </button>
  </div>

  <a
    href={review.link}
    target="_blank"
    rel="noopener"
    class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-brand-blue hover:underline"
  >
    <Icon name={sourceIcon} class="h-4 w-4" />
    {t.common.viewReview}
  </a>
</figure>

<script>
  function revealReviewToggles() {
    document.querySelectorAll<HTMLElement>('[data-review-toggle]').forEach((btn) => {
      const quote = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (quote && quote.scrollHeight > quote.clientHeight + 1) btn.classList.remove('hidden');
    });
  }
  document.addEventListener('astro:page-load', revealReviewToggles);

  // Delegated off document so it binds once and survives view transitions.
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const btn = target?.closest<HTMLElement>('[data-review-toggle]');
    if (!btn) return;
    const quote = document.getElementById(btn.getAttribute('aria-controls') ?? '');
    if (!quote) return;
    const expanded = quote.classList.toggle('line-clamp-6') === false;
    btn.setAttribute('aria-expanded', String(expanded));
    btn.textContent = (expanded ? btn.dataset.labelLess : btn.dataset.labelMore) ?? '';
  });
</script>
