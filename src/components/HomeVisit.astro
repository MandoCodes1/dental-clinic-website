---
import { Icon } from 'astro-icon/components';
import Map from '~/components/Map.astro';
import { content } from '~/content/site';
import { CLINIC, TREATMENTS, waLink } from '~/config';
import { ROUTES, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const v = t.homeVisit;
const c = t.contact;

const fieldClass =
  'mt-1 w-full rounded-xl border border-brand-blue/20 bg-white px-4 py-2.5 text-ink placeholder:text-ink/40 focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20';
---

<section class="section bg-white">
  <div class="container-page">
    <p class="eyebrow">{v.eyebrow}</p>
    <h2 class="mt-2 font-heading text-3xl text-brand-deep sm:text-4xl">{v.title}</h2>
    <p class="mt-3 max-w-2xl text-ink/75">{v.subtitle}</p>

    <div class="mt-10 grid items-start gap-10 lg:grid-cols-2">
      <form
        id="visit-form"
        class="card space-y-4"
        data-wa-base={waLink()}
        data-greeting={v.form.greeting}
        data-interest={v.form.interest}
      >
        <div>
          <label for="visit-name" class="text-sm font-medium text-brand-deep">{v.form.name}</label>
          <input
            id="visit-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder={v.form.namePlaceholder}
            class={fieldClass}
          />
        </div>

        <div>
          <label for="visit-treatment" class="text-sm font-medium text-brand-deep">{v.form.treatment}</label>
          <select id="visit-treatment" name="treatment" class={fieldClass}>
            <option value="">{v.form.treatmentPlaceholder}</option>
            {
              TREATMENTS.map((tr) => (
                <option value={t.treatments[tr.id].navLabel}>{t.treatments[tr.id].navLabel}</option>
              ))
            }
          </select>
        </div>

        <div>
          <label for="visit-message" class="text-sm font-medium text-brand-deep">{v.form.message}</label>
          <textarea
            id="visit-message"
            name="message"
            required
            rows="5"
            placeholder={v.form.messagePlaceholder}
            class={fieldClass}></textarea>
        </div>

        <button
          type="submit"
          class="btn-whatsapp w-full"
          data-umami-event="whatsapp"
          data-umami-event-location="home-form"
        >
          <Icon name="tabler:brand-whatsapp" class="h-6 w-6" />
          {v.form.submit}
        </button>
        <p class="text-xs text-ink/60">{v.form.hint}</p>
      </form>

      <div class="space-y-5">
        <div class="card flex items-start gap-4">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-blue/10 text-brand-blue"
          >
            <Icon name="tabler:map-pin" class="h-6 w-6" />
          </span>
          <div>
            <p class="font-heading text-lg text-brand-deep">{c.locationTitle}</p>
            <p class="mt-1 text-sm text-ink/70">{CLINIC.addressLine}, {CLINIC.addressCity}</p>
            <a
              href={CLINIC.mapsPlaceUrl}
              target="_blank"
              rel="noopener"
              class="mt-1 inline-block text-sm font-medium text-brand-blue hover:underline"
              data-umami-event="directions"
              data-umami-event-location="home"
            >
              {c.directions}
            </a>
          </div>
        </div>

        <div class="card flex items-start gap-4">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-blue/10 text-brand-blue"
          >
            <Icon name="tabler:clock-hour-4" class="h-6 w-6" />
          </span>
          <div>
            <p class="font-heading text-lg text-brand-deep">{c.hoursTitle}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink/70">{c.hoursBody}</p>
          </div>
        </div>

        <Map lang={lang} />

        <a href={ROUTES.contact[lang]} class="inline-block font-medium text-brand-blue hover:underline">
          {v.contactLink}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  function initVisitForm() {
    const form = document.getElementById('visit-form');
    if (!(form instanceof HTMLFormElement)) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const treatment = String(data.get('treatment') ?? '');
      const message = String(data.get('message') ?? '').trim();
      const d = form.dataset;
      let text = `${d.greeting} ${name}.`;
      if (treatment) text += ` ${d.interest} ${treatment}.`;
      text += `\n\n${message}`;
      window.open(`${d.waBase}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
  }
  document.addEventListener('astro:page-load', initVisitForm);
</script>
