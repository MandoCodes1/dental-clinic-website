---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import type { ServiceDetail } from '~/content/site';

interface Props {
  detail: ServiceDetail;
  image: ImageMetadata;
  anchor: string;
  reversed?: boolean;
}
const { detail, image, anchor, reversed = false } = Astro.props;
---

<div id={anchor} class="grid scroll-mt-24 items-center gap-8 lg:grid-cols-2 lg:gap-12">
  <div class={reversed ? 'lg:order-2' : ''}>
    <Image
      src={image}
      alt={detail.title}
      widths={[400, 600, 800]}
      sizes="(max-width: 1024px) 90vw, 480px"
      class="mx-auto w-full max-w-md rounded-2xl bg-white object-contain shadow-sm lg:max-w-none"
    />
  </div>
  <div class={reversed ? 'lg:order-1' : ''}>
    <h2 class="font-heading text-2xl text-brand-deep sm:text-3xl">{detail.title}</h2>
    <p class="mt-3 leading-relaxed text-ink/75">{detail.lead}</p>
    <ul class="mt-5 space-y-2.5">
      {
        detail.points.map((p) => (
          <li class="flex gap-2.5 text-ink/80">
            <Icon name="tabler:check" class="mt-1 h-4 w-4 shrink-0 text-brand-green" />
            <span>{p}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
