---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface CaseItem {
  before: ImageMetadata;
  after: ImageMetadata;
  title: string;
}
interface Props {
  cases: CaseItem[];
  beforeLabel: string;
  afterLabel: string;
}
const { cases, beforeLabel, afterLabel } = Astro.props;
---

<div class="grid gap-6 sm:grid-cols-2">
  {
    cases.map((c) => (
      <figure class="card overflow-hidden p-0">
        <div class="grid grid-cols-2">
          <div class="relative">
            <Image
              src={c.before}
              alt={`${beforeLabel}: ${c.title}`}
              widths={[300, 500]}
              sizes="(max-width: 640px) 50vw, 260px"
              class="aspect-[4/3] w-full object-cover"
            />
            <span class="absolute left-2 top-2 rounded-full bg-ink/75 px-2 py-0.5 text-xs font-medium text-white">
              {beforeLabel}
            </span>
          </div>
          <div class="relative">
            <Image
              src={c.after}
              alt={`${afterLabel}: ${c.title}`}
              widths={[300, 500]}
              sizes="(max-width: 640px) 50vw, 260px"
              class="aspect-[4/3] w-full object-cover"
            />
            <span class="absolute left-2 top-2 rounded-full bg-brand-deep px-2 py-0.5 text-xs font-medium text-white">
              {afterLabel}
            </span>
          </div>
        </div>
        <figcaption class="px-4 py-3 text-sm font-medium text-brand-deep">{c.title}</figcaption>
      </figure>
    ))
  }
</div>
