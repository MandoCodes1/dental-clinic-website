---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '~/assets/images/brand/logo2.png';
import LanguageToggle from '~/components/LanguageToggle.astro';
import { content } from '~/content/site';
import { ROUTES, NAV_MORE, type Lang, type NavKey, type RouteKey } from '~/i18n';
import { TREATMENTS, waLink } from '~/config';

interface Props {
  lang: Lang;
  page: RouteKey;
}
const { lang, page } = Astro.props;
const t = content[lang];
const homeHref = ROUTES.home[lang];
const toItem = (key: NavKey) => ({ label: t.nav[key], href: ROUTES[key][lang], active: key === page });
const home = toItem('home');
const about = toItem('about');
const reviews = toItem('reviews');
const contact = toItem('contact');
const navMore = NAV_MORE.map(toItem);
// Keep each dropdown trigger highlighted while one of the pages behind it is open.
const treatmentsActive = page === 'treatments' || page.startsWith('treatment');
const moreActive = (NAV_MORE as readonly RouteKey[]).includes(page);
const treatmentLinks = TREATMENTS.map((tr) => ({
  label: t.treatments[tr.id].navLabel,
  href: ROUTES[tr.route][lang],
  active: tr.route === page,
}));
---

<header class="sticky top-0 z-40 border-b border-brand-blue/10 bg-cream/90 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={homeHref} class="flex items-center gap-2.5" aria-label="Dra. Eugenia Vila">
      <Image src={logo} alt="" width={435} height={316} class="h-9 w-auto" />
      <span class="font-heading text-lg font-semibold text-brand-deep">Dra. Eugenia Vila</span>
    </a>

    <nav class="hidden items-center gap-5 lg:flex xl:gap-6" aria-label={t.nav.home}>
      <a
        href={home.href}
        class:list={[
          'text-sm font-medium transition hover:text-brand-blue',
          home.active ? 'text-brand-blue' : 'text-ink/80',
        ]}
        aria-current={home.active ? 'page' : undefined}
      >
        {home.label}
      </a>

      <a
        href={about.href}
        class:list={[
          'text-sm font-medium transition hover:text-brand-blue',
          about.active ? 'text-brand-blue' : 'text-ink/80',
        ]}
        aria-current={about.active ? 'page' : undefined}
      >
        {about.label}
      </a>

      <div class="relative" data-dropdown>
        <button
          type="button"
          data-dropdown-toggle
          class:list={[
            'inline-flex items-center gap-1 text-sm font-medium transition hover:text-brand-blue',
            treatmentsActive ? 'text-brand-blue' : 'text-ink/80',
          ]}
          aria-expanded="false"
          aria-controls="treatments-menu"
        >
          {t.nav.treatments}
          <Icon name="tabler:chevron-down" class="h-4 w-4" />
        </button>
        {
          /* Hover opens the menu too (see the script below; the click toggle stays
          for touch and keyboard). The before: strip bridges the mt-3 gap so the
          pointer can travel from the trigger into the menu without it closing. */
        }
        <div
          id="treatments-menu"
          class="absolute left-0 top-full mt-3 hidden w-64 rounded-xl border border-brand-blue/10 bg-cream p-2 shadow-lg before:absolute before:inset-x-0 before:-top-3 before:h-3 before:content-['']"
        >
          <a
            href={ROUTES.treatments[lang]}
            class:list={[
              'block rounded-md px-3 py-2 text-sm font-semibold transition hover:bg-brand-light',
              page === 'treatments' ? 'text-brand-blue' : 'text-brand-deep',
            ]}
            aria-current={page === 'treatments' ? 'page' : undefined}
          >
            {t.treatmentsPage.allLabel}
          </a>
          <div class="my-1 border-t border-brand-blue/10"></div>
          {
            treatmentLinks.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'block rounded-md px-3 py-2 text-sm font-medium transition hover:bg-brand-light',
                  item.active ? 'text-brand-blue' : 'text-ink/80',
                ]}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <a
        href={reviews.href}
        class:list={[
          'text-sm font-medium transition hover:text-brand-blue',
          reviews.active ? 'text-brand-blue' : 'text-ink/80',
        ]}
        aria-current={reviews.active ? 'page' : undefined}
      >
        {reviews.label}
      </a>

      <div class="relative" data-dropdown>
        <button
          type="button"
          data-dropdown-toggle
          class:list={[
            'inline-flex items-center gap-1 text-sm font-medium transition hover:text-brand-blue',
            moreActive ? 'text-brand-blue' : 'text-ink/80',
          ]}
          aria-expanded="false"
          aria-controls="more-menu"
        >
          {t.nav.more}
          <Icon name="tabler:chevron-down" class="h-4 w-4" />
        </button>
        <div
          id="more-menu"
          class="absolute right-0 top-full mt-3 hidden w-60 rounded-xl border border-brand-blue/10 bg-cream p-2 shadow-lg before:absolute before:inset-x-0 before:-top-3 before:h-3 before:content-['']"
        >
          {
            navMore.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'block rounded-md px-3 py-2 text-sm font-medium transition hover:bg-brand-light',
                  item.active ? 'text-brand-blue' : 'text-ink/80',
                ]}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <a
        href={contact.href}
        class:list={[
          'text-sm font-medium transition hover:text-brand-blue',
          contact.active ? 'text-brand-blue' : 'text-ink/80',
        ]}
        aria-current={contact.active ? 'page' : undefined}
      >
        {contact.label}
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <LanguageToggle lang={lang} />
      <a
        href={waLink(t.contactCta.defaultMessage)}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2 rounded-full bg-whatsapp px-4 py-2 text-sm font-semibold text-white transition hover:brightness-95 sm:inline-flex"
        data-umami-event="whatsapp"
        data-umami-event-location="header"
      >
        <Icon name="tabler:brand-whatsapp" class="h-6 w-6" />
        {t.nav.book}
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-brand-deep hover:bg-brand-light lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.a11y.openMenu}
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <Icon name="tabler:menu-2" class="h-6 w-6" />
      </button>
    </div>
  </div>

  {
    /* The treatment links stay expanded (no tap-to-open) so nothing is hidden
      behind an extra tap for less tech-confident visitors. */
  }
  <div id="mobile-menu" class="hidden border-t border-brand-blue/10 bg-cream lg:hidden">
    <nav class="container-page flex flex-col divide-y divide-brand-blue/10 py-2" aria-label={t.nav.home}>
      <a
        href={home.href}
        class:list={['px-2 py-3 text-base font-medium', home.active ? 'text-brand-blue' : 'text-ink/80']}
        aria-current={home.active ? 'page' : undefined}
      >
        {home.label}
      </a>
      <a
        href={about.href}
        class:list={['px-2 py-3 text-base font-medium', about.active ? 'text-brand-blue' : 'text-ink/80']}
        aria-current={about.active ? 'page' : undefined}
      >
        {about.label}
      </a>
      <div>
        <button
          type="button"
          data-accordion-toggle
          aria-controls="mobile-treatments"
          aria-expanded={treatmentsActive ? 'true' : 'false'}
          class:list={[
            'group flex w-full items-center justify-between px-2 py-3 text-left text-base font-medium',
            treatmentsActive ? 'text-brand-blue' : 'text-ink/80',
          ]}
        >
          {t.nav.treatments}
          <Icon
            name="tabler:chevron-down"
            class="h-5 w-5 shrink-0 transition-transform group-aria-expanded:rotate-180"
          />
        </button>
        <div id="mobile-treatments" class:list={['pb-2', !treatmentsActive && 'hidden']}>
          <a
            href={ROUTES.treatments[lang]}
            class:list={[
              'block py-2.5 pl-6 pr-2 text-base font-semibold',
              page === 'treatments' ? 'text-brand-blue' : 'text-ink/80',
            ]}
            aria-current={page === 'treatments' ? 'page' : undefined}
          >
            {t.treatmentsPage.allLabel}
          </a>
          {
            treatmentLinks.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'block py-2.5 pl-6 pr-2 text-base font-medium',
                  item.active ? 'text-brand-blue' : 'text-ink/70',
                ]}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
      {
        [reviews, ...navMore, contact].map((item) => (
          <a
            href={item.href}
            class:list={['px-2 py-3 text-base font-medium', item.active ? 'text-brand-blue' : 'text-ink/80']}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <div class="pt-3 pb-1">
        <a
          href={waLink(t.contactCta.defaultMessage)}
          target="_blank"
          rel="noopener"
          class="btn-whatsapp w-full"
          data-umami-event="whatsapp"
          data-umami-event-location="header-mobile"
        >
          <Icon name="tabler:brand-whatsapp" class="h-6 w-6" />
          {t.nav.book}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // The label has to follow the state: a screen reader user hearing "Abrir menú"
  // on an open menu has no way to tell that the same button closes it.
  function setMobileMenu(btn: HTMLElement, menu: HTMLElement, open: boolean) {
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    const label = open ? btn.dataset.labelClose : btn.dataset.labelOpen;
    if (label) btn.setAttribute('aria-label', label);
  }

  function initMenu() {
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      setMobileMenu(btn, menu, menu.classList.contains('hidden'));
    });
  }
  document.addEventListener('astro:page-load', initMenu);

  // The desktop dropdowns are delegated off document so the listeners bind once
  // and survive view transitions; binding per page-load would stack them instead.
  function dropdownToggles(): HTMLElement[] {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-dropdown-toggle]'));
  }

  function menuFor(btn: HTMLElement): HTMLElement | null {
    return document.getElementById(btn.getAttribute('aria-controls') ?? '');
  }

  // Every way of opening or closing a menu goes through here, so aria-expanded
  // always matches what is on screen.
  function setDropdown(btn: HTMLElement, open: boolean) {
    const menu = menuFor(btn);
    if (!menu) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    if (!open) delete btn.dataset.hoverOpen;
  }

  function closeDropdown(btn: HTMLElement): boolean {
    const menu = menuFor(btn);
    if (!menu || menu.classList.contains('hidden')) return false;
    setDropdown(btn, false);
    return true;
  }

  function toggleIn(el: EventTarget | null): HTMLElement | null {
    const wrap = el instanceof Element ? el.closest('[data-dropdown]') : null;
    return wrap?.querySelector<HTMLElement>('[data-dropdown-toggle]') ?? null;
  }

  // Mouse hover only: touch taps also fire pointer events and must stay on the
  // click toggle.
  document.addEventListener('pointerover', (event) => {
    if (event.pointerType !== 'mouse') return;
    const btn = toggleIn(event.target);
    if (!btn || btn.getAttribute('aria-expanded') === 'true') return;
    setDropdown(btn, true);
    btn.dataset.hoverOpen = 'true';
  });

  document.addEventListener('pointerout', (event) => {
    if (event.pointerType !== 'mouse') return;
    const btn = toggleIn(event.target);
    if (!btn || btn.dataset.hoverOpen !== 'true') return;
    if (toggleIn(event.relatedTarget) === btn) return;
    setDropdown(btn, false);
  });

  // Tabbing past the last link (or anywhere outside) closes the menu, so it does
  // not stay open over the page with nothing focused inside it.
  document.addEventListener('focusout', (event) => {
    const btn = toggleIn(event.target);
    if (!btn || toggleIn(event.relatedTarget) === btn) return;
    closeDropdown(btn);
  });

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const toggles = dropdownToggles();
    const clicked = toggles.find((btn) => target && btn.contains(target));
    for (const btn of toggles) {
      if (btn !== clicked) {
        const menu = menuFor(btn);
        // Leave a menu open when the click landed inside it (its links navigate anyway).
        if (!clicked && menu && target && menu.contains(target)) continue;
        closeDropdown(btn);
      }
    }
    if (clicked) {
      // A click on a menu that hover has just opened keeps it open (and pinned
      // once the pointer leaves) instead of closing it under the cursor.
      if (clicked.dataset.hoverOpen === 'true') {
        delete clicked.dataset.hoverOpen;
        return;
      }
      setDropdown(clicked, clicked.getAttribute('aria-expanded') !== 'true');
    }
  });

  // The mobile accordion is delegated off document too (bind once, survive view
  // transitions). Unlike the dropdowns it must not close on outside clicks: it
  // lives inside the open mobile menu, so only its own button toggles it.
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const btn = target?.closest<HTMLElement>('[data-accordion-toggle]');
    if (!btn) return;
    const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
    if (!panel) return;
    const isOpen = panel.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const btn of dropdownToggles()) {
      if (closeDropdown(btn)) btn.focus();
    }
    const menuBtn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (menuBtn && menu && !menu.classList.contains('hidden')) {
      setMobileMenu(menuBtn, menu, false);
      menuBtn.focus();
    }
  });
</script>
