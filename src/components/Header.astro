---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '~/assets/images/brand/logo2.png';
import LanguageToggle from '~/components/LanguageToggle.astro';
import { content } from '~/content/site';
import { ROUTES, NAV_TOP, NAV_MORE, NAV_TAIL, NAV_ALL, type Lang, type NavKey, type RouteKey } from '~/i18n';
import { waLink } from '~/config';

interface Props {
  lang: Lang;
  page: RouteKey;
}
const { lang, page } = Astro.props;
const t = content[lang];
const homeHref = ROUTES.home[lang];
const toItem = (key: NavKey) => ({ label: t.nav[key], href: ROUTES[key][lang], active: key === page });
const navTop = NAV_TOP.map(toItem);
const navMore = NAV_MORE.map(toItem);
const navTail = NAV_TAIL.map(toItem);
const navAll = NAV_ALL.map(toItem);
// Keep the dropdown trigger highlighted while one of the pages behind it is open.
const moreActive = (NAV_MORE as readonly RouteKey[]).includes(page);
---

<header class="sticky top-0 z-40 border-b border-brand-blue/10 bg-cream/90 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={homeHref} class="flex items-center gap-2.5" aria-label="Dra. Eugenia Vila">
      <Image src={logo} alt="" width={435} height={316} class="h-9 w-auto" />
      <span class="font-heading text-lg font-semibold text-brand-deep">Dra. Eugenia Vila</span>
    </a>

    <nav class="hidden items-center gap-5 lg:flex xl:gap-6" aria-label={t.nav.home}>
      {
        navTop.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition hover:text-brand-blue',
              item.active ? 'text-brand-blue' : 'text-ink/80',
            ]}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }

      <div class="relative">
        <button
          type="button"
          id="more-toggle"
          class:list={[
            'inline-flex items-center gap-1 text-sm font-medium transition hover:text-brand-blue',
            moreActive ? 'text-brand-blue' : 'text-ink/80',
          ]}
          aria-expanded="false"
          aria-controls="more-menu"
        >
          {t.nav.more}
          <Icon name="tabler:chevron-down" class="h-4 w-4" />
        </button>
        <div
          id="more-menu"
          class="absolute right-0 top-full mt-3 hidden w-60 rounded-xl border border-brand-blue/10 bg-cream p-2 shadow-lg"
        >
          {
            navMore.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'block rounded-md px-3 py-2 text-sm font-medium transition hover:bg-brand-light',
                  item.active ? 'text-brand-blue' : 'text-ink/80',
                ]}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      {
        navTail.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition hover:text-brand-blue',
              item.active ? 'text-brand-blue' : 'text-ink/80',
            ]}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <LanguageToggle lang={lang} />
      <a
        href={waLink(t.contactCta.defaultMessage)}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2 rounded-full bg-whatsapp px-4 py-2 text-sm font-semibold text-white transition hover:brightness-95 sm:inline-flex"
        data-umami-event="whatsapp"
        data-umami-event-location="header"
      >
        <Icon name="tabler:brand-whatsapp" class="h-6 w-6" />
        {t.nav.book}
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-brand-deep hover:bg-brand-light lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.a11y.openMenu}
      >
        <Icon name="tabler:menu-2" class="h-6 w-6" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-brand-blue/10 bg-cream lg:hidden">
    <nav class="container-page flex flex-col py-3" aria-label={t.nav.home}>
      {
        navAll.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-md px-2 py-2.5 text-base font-medium',
              item.active ? 'text-brand-blue' : 'text-ink/80',
            ]}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={waLink(t.contactCta.defaultMessage)}
        target="_blank"
        rel="noopener"
        class="btn-whatsapp mt-2"
        data-umami-event="whatsapp"
        data-umami-event-location="header-mobile"
      >
        <Icon name="tabler:brand-whatsapp" class="h-6 w-6" />
        {t.nav.book}
      </a>
    </nav>
  </div>
</header>

<script>
  function initMenu() {
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  }
  document.addEventListener('astro:page-load', initMenu);

  // The "more" dropdown is delegated off document so the listeners bind once and
  // survive view transitions; binding per page-load would stack them instead.
  function moreEls() {
    return {
      btn: document.getElementById('more-toggle'),
      menu: document.getElementById('more-menu'),
    };
  }

  function closeMore() {
    const { btn, menu } = moreEls();
    if (!btn || !menu || menu.classList.contains('hidden')) return false;
    menu.classList.add('hidden');
    btn.setAttribute('aria-expanded', 'false');
    return true;
  }

  document.addEventListener('click', (event) => {
    const { btn, menu } = moreEls();
    if (!btn || !menu) return;
    const target = event.target instanceof Element ? event.target : null;
    if (target && btn.contains(target)) {
      const isOpen = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(isOpen));
    } else if (!target || !menu.contains(target)) {
      closeMore();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (closeMore()) moreEls().btn?.focus();
  });
</script>
