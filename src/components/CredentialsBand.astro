---
import { Icon } from 'astro-icon/components';
import { content } from '~/content/site';
import { CLINIC } from '~/config';
import { getAllReviews } from '~/utils/reviews';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].credentials;
const locale = lang === 'es' ? 'es-ES' : 'en-GB';
const reviewCount = getAllReviews().length;

const stats = [
  { icon: 'tabler:calendar-heart', value: String(CLINIC.years), label: c.yearsLabel },
  { icon: 'tabler:users', value: `${CLINIC.patients.toLocaleString(locale)}+`, label: c.patientsLabel },
  // Rating first: the score is the claim, the count is the evidence behind it.
  { icon: 'tabler:star-filled', value: '5.0/5.0', label: c.reviewsLabel.replace('{count}', String(reviewCount)) },
  { icon: 'tabler:award', value: c.awardValue, label: c.awardLabel },
];
---

<section class="bg-brand-deep text-white">
  <div class="container-page py-12 sm:py-14">
    <h2 class="text-center font-heading text-2xl text-white sm:text-3xl">{c.title}</h2>
    <dl class="mt-8 grid grid-cols-2 gap-6 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="text-center">
            <Icon name={s.icon} class="mx-auto h-7 w-7 text-brand-sky" />
            <dt class="mt-2 font-heading text-3xl font-semibold text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-1 text-sm text-cream/70">{s.label}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mx-auto mt-8 max-w-3xl text-center text-sm leading-relaxed text-cream/70">{c.note}</p>
  </div>
</section>
