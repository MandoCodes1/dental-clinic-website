---
import { Icon } from 'astro-icon/components';
import FaqList from '~/components/FaqList.astro';
import { content } from '~/content/site';
import { ROUTES, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];

// The highest-intent questions, as indices into faqPage.items: implant price,
// why the prices are low, the first visit, and how to book around her calendar.
// SiteCopy keeps both locales' arrays parallel, so the indices hold for each.
const FEATURED = [0, 1, 5, 4];
const items = FEATURED.map((i) => t.faqPage.items[i]).filter((item) => item !== undefined);
---

{/* No bottom padding: the CTA below is cream too, so it would only stack with its own. */}
<section class="section pb-0">
  <div class="container-page">
    {/* Same max-w-3xl column as the accordion, so the heading lines up with the cards. */}
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">{t.homeFaq.eyebrow}</p>
      <h2 class="mt-2 font-heading text-3xl text-brand-deep sm:text-4xl">{t.homeFaq.title}</h2>
      <p class="mt-3 text-ink/75">{t.homeFaq.subtitle}</p>
    </div>

    <div class="mt-10">
      <FaqList items={items} />
    </div>

    <div class="mt-8 text-center">
      <a href={ROUTES.faq[lang]} class="btn-outline">
        {t.homeFaq.viewAll}
        <Icon name="tabler:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
