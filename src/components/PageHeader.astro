---
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<section class="bg-brand-light/40">
  <div class="container-page py-12 sm:py-16">
    <h1 class="font-heading text-4xl text-brand-deep sm:text-5xl">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/75">{lead}</p>}
  </div>
</section>
