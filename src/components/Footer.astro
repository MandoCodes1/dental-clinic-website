---
import { Icon } from 'astro-icon/components';
import { content } from '~/content/site';
import { ROUTES, NAV_KEYS, type Lang } from '~/i18n';
import { CLINIC, SERVICES, waLink } from '~/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const year = new Date().getFullYear();
const servicesHref = ROUTES.services[lang];
---

<footer class="bg-brand-deep text-cream/90">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-heading text-xl text-white">Dra. Eugenia Vila</p>
      <p class="mt-3 max-w-xs text-sm text-cream/70">{t.footer.tagline}</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">{t.footer.servicesTitle}</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          t.services.items.map((s) => {
            const anchor = SERVICES.find((x) => x.id === s.id)?.anchor;
            return (
              <li>
                <a class="text-cream/80 transition hover:text-white" href={`${servicesHref}#${anchor}`}>
                  {s.title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">{t.footer.navTitle}</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          NAV_KEYS.map((key) => (
            <li>
              <a class="text-cream/80 transition hover:text-white" href={ROUTES[key][lang]}>
                {t.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">{t.footer.contactTitle}</h2>
      <ul class="mt-3 space-y-3 text-sm text-cream/80">
        <li>
          <a
            href={waLink()}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 transition hover:text-white"
          >
            <Icon name="tabler:brand-whatsapp" class="h-4 w-4" />
            {CLINIC.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${CLINIC.email}`} class="inline-flex items-center gap-2 transition hover:text-white">
            <Icon name="tabler:mail" class="h-4 w-4" />
            {CLINIC.email}
          </a>
        </li>
        <li>
          <a
            href={CLINIC.mapsPlaceUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-start gap-2 transition hover:text-white"
          >
            <Icon name="tabler:map-pin" class="mt-0.5 h-4 w-4 shrink-0" />
            <span>{CLINIC.addressLine}, {CLINIC.addressCity}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col items-center justify-between gap-3 py-5 text-xs text-cream/60 sm:flex-row">
      <p>© {year} Dra. Eugenia Vila. {t.footer.rights}</p>
      <div class="flex gap-4">
        <a href={ROUTES.privacy[lang]} class="transition hover:text-white">{lang === 'es' ? 'Privacidad' : 'Privacy'}</a
        >
        <a href={ROUTES.terms[lang]} class="transition hover:text-white">{lang === 'es' ? 'Términos' : 'Terms'}</a>
      </div>
    </div>
  </div>
</footer>
