---
import { Icon } from 'astro-icon/components';
import { content } from '~/content/site';
import { SERVICES } from '~/config';
import { ROUTES, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = content[lang].services;
const servicesHref = ROUTES.services[lang];
const itemsById = new Map(s.items.map((i) => [i.id, i]));
---

<section class="section bg-white">
  <div class="container-page">
    <p class="eyebrow">{s.eyebrow}</p>
    <h2 class="mt-2 max-w-2xl font-heading text-3xl text-brand-deep sm:text-4xl">{s.title}</h2>
    <p class="mt-3 max-w-2xl text-ink/75">{s.subtitle}</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        SERVICES.map((svc) => {
          const item = itemsById.get(svc.id);
          if (!item) return null;
          return (
            <a
              href={`${servicesHref}#${svc.anchor}`}
              class="card group flex flex-col transition hover:border-brand-teal/30 hover:shadow-md"
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-light text-brand-teal">
                <Icon name={svc.icon} class="h-6 w-6" />
              </span>
              <h3 class="mt-4 font-heading text-lg text-brand-deep">{item.title}</h3>
              <p class="mt-2 grow text-sm leading-relaxed text-ink/75">{item.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-teal">
                {s.learnMore}
                <Icon name="tabler:arrow-right" class="h-4 w-4 transition group-hover:translate-x-0.5" />
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
