---
import { switchLangPath, LANG_META, type Lang } from '~/i18n';
import { content } from '~/content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const href = switchLangPath(Astro.url.pathname);
const t = content[lang];
---

<a
  href={href}
  hreflang={other}
  aria-label={t.a11y.switchLang}
  class="inline-flex items-center rounded-full border border-brand-blue/20 px-2.5 py-1 text-xs font-semibold text-brand-deep transition hover:bg-brand-light"
>
  {LANG_META[other].label}
</a>
