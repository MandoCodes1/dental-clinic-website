---
import { Icon } from 'astro-icon/components';
import { switchLangPath, type Lang } from '~/i18n';
import { content } from '~/content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const href = switchLangPath(Astro.url.pathname);
const t = content[lang];
---

<a
  href={href}
  hreflang={other}
  aria-label={t.a11y.switchLang}
  title={t.a11y.switchLang}
  class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full transition hover:bg-brand-light"
>
  <Icon
    name={other === 'en' ? 'circle-flags:gb' : 'circle-flags:es'}
    class="h-7 w-7 rounded-full ring-1 ring-brand-deep/15"
    aria-hidden="true"
  />
</a>
