---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { ROUTES } from '~/i18n';
---

<BaseLayout
  lang="es"
  page="home"
  title="404 - Página no encontrada · Dra. Eugenia Vila"
  description="Página no encontrada."
>
  <section class="section">
    <div class="container-page text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-2 font-heading text-3xl text-brand-deep sm:text-4xl">Página no encontrada · Page not found</h1>
      <p class="mx-auto mt-3 max-w-md text-ink/75">
        Lo sentimos, no encontramos esta página. / Sorry, we couldn't find this page.
      </p>
      <div class="mt-7 flex justify-center gap-3">
        <a href={ROUTES.home.es} class="btn-primary">Inicio</a>
        <a href={ROUTES.home.en} class="btn-outline">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
